# ─────────── OpenAI ───────────
# ⚠️ 아래는 실제 동작하지 않는 가상 키입니다.
#    배포 전 실제 키로 교체하세요. (교체 지점: 이 파일 1곳뿐)
OPENAI_API_KEY=sk-proj-DUMMY-replace-with-your-real-key

OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# ─────────── 앱 설정 ───────────
# true 이면 OpenAI를 호출하지 않고 lib/mock/*.ts 의 고정 응답을 반환한다.
MOCK_MODE=true

# 교사 페이지 접근 비밀번호 (선택 기능)
TEACHER_PASSCODE=1234
